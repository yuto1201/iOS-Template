    "review-prompt.feedback-invitation" : {
      "comment" : "Shown after \"Not great\" when the build can send feedback or open the support page.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you like, tell us how we could make it better."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よろしければ、改善のためにご意見をお聞かせください。"
          }
        }
      }
    },
    "review-prompt.later" : {
      "comment" : "Closes the review prompt without an answer.",
