    "feedback.disclosure" : {
      "comment" : "What is sent with feedback, and what is not.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent anonymously to the developer with the app and iOS versions, device model, and language and region settings. Your data in the app and your contact details are not sent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開発者へ匿名で送信します。アプリとiOSのバージョン、端末の機種、言語と地域の設定を添えます。アプリ内のデータと連絡先は送信しません。"
          }
        }
      }
    },
    "feedback.entry" : {
      "comment" : "Shown on the entry that opens the anonymous feedback sheet.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send Feedback"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードバックを送る"
          }
        }
      }
    },
    "feedback.error.offline" : {
      "comment" : "No connection; the message is kept for another try.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't connect. Check your connection and send again. Your message is kept."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続できませんでした。通信環境を確認して、もう一度送信してください。入力した内容は残っています。"
          }
        }
      }
    },
    "feedback.error.rate-limited" : {
      "comment" : "The feedback service limits how often messages are accepted.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many messages right now. Try again later."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信が集中しています。時間をおいて、もう一度送信してください。"
          }
        }
      }
    },
    "feedback.error.server" : {
      "comment" : "The feedback service could not accept the message.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
